# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Download Engine ────────────────────────────────
# Path to yt-dlp binary. Leave empty to auto-detect from PATH.
YTDLP_PATH=

# Download timeout (seconds per download)
DOWNLOAD_TIMEOUT=120

# Max file size (bytes). 1GB default.
MAX_DOWNLOAD_SIZE=1073741824

# Concurrent DASH fragment downloads (yt-dlp --concurrent-fragments / -N).
# High-res video streams are fragmented; pulling several at once massively speeds up 4K/2K.
# Min 1, max 16.
DOWNLOAD_FRAGMENTS=4

# Paths to ffmpeg / ffprobe. Leave empty to auto-detect from PATH.
# Used to re-encode high-res (VP9/AV1) sources to H.264/AAC so files play in
# Windows Media Player, phones, TVs, etc. 1080p and below are already H.264 and are
# NOT re-encoded (fast path).
FFMPEG_PATH=
FFPROBE_PATH=

# Timeout (seconds) for the H.264 re-encode step. This is CPU-bound and can take
# several minutes for a 4K file, so it is separate from DOWNLOAD_TIMEOUT.
CONVERT_TIMEOUT=1800

# How long a finished download job (and its temp file) is kept before cleanup (ms).
DOWNLOAD_JOB_TTL_MS=1800000

# ── Rate Limiting (in-memory per IP) ───────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000